function KapukaState.safeConfigName(name)
name = tostring(name or ""):gsub("[<>:\"/\\|%?%*]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
if name == "" then name = KapukaState.DEFAULT_CONFIG_NAME end
if #name > 48 then name = name:sub(1, 48) end
return name
end
function KapukaState.configPath(name)
return KapukaState.CONFIG_FOLDER .. "/" .. KapukaState.safeConfigName(name) .. ".json"
