humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
humanoid.UseJumpPower = true
humanoid.JumpPower = 0
humanoid.JumpHeight = 0
humanoid.CameraOffset = Vector3.new(0, 2.2, 0)
pcall(function()
humanoid:ChangeState(Enum.HumanoidStateType.Physics)
end)
local bodyVelocity = Instance.new("BodyVelocity")
bodyVelocity.Name = "KapukaIronFlightVelocity"
bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
bodyVelocity.P = 8000
bodyVelocity.Velocity = root.AssemblyLinearVelocity
bodyVelocity.Parent = root
local bodyGyro = Instance.new("BodyGyro")
bodyGyro.Name = "KapukaIronFlightGyro"
bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
bodyGyro.P = 5000
bodyGyro.D = 500
bodyGyro.CFrame = root.CFrame
bodyGyro.Parent = root
KapukaState.flightObjects.BodyVelocity = bodyVelocity
KapukaState.flightObjects.BodyGyro = bodyGyro
KapukaState.flightCurrentVelocity = root.AssemblyLinearVelocity
KapukaState.flightConnection = KapukaState.RunService.RenderStepped:Connect(function(dt)
if KapukaState.isClosing or not KapukaState.MovementSettings.Fly then
KapukaState.stopFlight()
return
end
local currentCharacter, currentHumanoid, currentRoot = KapukaState.getFlightCharacter()
if currentCharacter ~= character
or currentHumanoid ~= humanoid
or currentRoot ~= root
or currentHumanoid.Health <= 0
or not bodyVelocity.Parent
or not bodyGyro.Parent then
KapukaState.stopFlight()
return
end
local camera = KapukaState.GetCamera()
if not camera then
return
end
local look = camera.CFrame.LookVector
local right = camera.CFrame.RightVector
local up = Vector3.new(0, 1, 0)
local direction = Vector3.zero
local wDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.W)
local sDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.S)
local aDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.A)
local dDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.D)
local upDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.Space)
local downDown = KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
or KapukaState.UserInputService:IsKeyDown(Enum.KeyCode.C)
if wDown then direction += look end
if sDown then direction -= look end
if aDown then direction -= right end
if dDown then direction += right end
if upDown then direction += up end
if downDown then direction -= up end
local moving = direction.Magnitude > 0.05
if moving then
direction = direction.Unit
end
local targetVelocity = moving and (direction * KapukaState.MovementSettings.FlySpeed) or Vector3.zero
local acceleration = math.max(KapukaState.MovementSettings.FlyAcceleration, 1)
local blend = 1 - math.exp(-(moving and acceleration or acceleration * 0.55) * dt)
KapukaState.flightCurrentVelocity = KapukaState.flightCurrentVelocity:Lerp(targetVelocity, math.clamp(blend, 0, 1))
bodyVelocity.Velocity = KapukaState.flightCurrentVelocity
local horizontalLook = Vector3.new(look.X, 0, look.Z)
if horizontalLook.Magnitude < 0.001 then
horizontalLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
end
horizontalLook = horizontalLook.Unit
local facing = CFrame.lookAt(
root.Position,
root.Position + horizontalLook,
Vector3.new(0, 1, 0)
)
local roll = 0
if aDown then
roll = math.rad(-28)
elseif dDown then
roll = math.rad(28)
end
local bodyLean = math.rad(-82)
if wDown then
bodyLean = math.rad(-90)
elseif sDown then
bodyLean = math.rad(55)
end
bodyGyro.CFrame = facing * CFrame.Angles(bodyLean, 0, roll)
for motor in pairs(KapukaState.flightMotorTransforms) do
if motor and motor.Parent and motor.Name ~= "Neck" then
motor.Transform = CFrame.new()
end
end
local torso = character:FindFirstChild("Torso")
or character:FindFirstChild("UpperTorso")
local neck = torso and (torso:FindFirstChild("Neck")
or torso:FindFirstChild("Neck", true))
if neck then
local localLook = root.CFrame:ToObjectSpace(camera.CFrame).LookVector
local neckYaw = math.clamp(-localLook.X * 0.65, -0.75, 0.75)
local neckPitch = math.clamp(localLook.Y * 0.6, -0.55, 0.55)
if wDown then
neckPitch += 0.18
end
local baseTransform = KapukaState.flightMotorTransforms[neck]
if baseTransform then
local targetNeck = baseTransform * CFrame.Angles(-neckPitch, 0, neckYaw)
neck.Transform = neck.Transform:Lerp(targetNeck, 1 - math.exp(-14 * dt))
end
end
end)
end
