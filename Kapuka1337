if KapukaState.antiFlingOriginalGroups[obj] == nil then
KapukaState.antiFlingOriginalGroups[obj] = obj.CollisionGroup
end
pcall(function() obj.CollisionGroup = KapukaState.antiFlingLocalGroup end)
end
end
local descendantConnection = character.DescendantAdded:Connect(function(obj)
if KapukaState.MovementSettings.AntiFling and obj:IsA("BasePart") then
if KapukaState.antiFlingOriginalGroups[obj] == nil then
KapukaState.antiFlingOriginalGroups[obj] = obj.CollisionGroup
end
pcall(function() obj.CollisionGroup = KapukaState.antiFlingLocalGroup end)
end
end)
table.insert(KapukaState.antiFlingConnections, descendantConnection)
end
function KapukaState.clearAntiFling()
