function KapukaState.executeConsoleCommand(command)
command = tostring(command or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
if command == "" then return end
KapukaState.appendConsoleLine("> " .. command)
local name, args = command:match("^(%S+)%s*(.*)$")
name = name or command
args = args or ""
if name == "help" then
KapukaState.appendConsoleLine(KapukaState.t("Команды: help, clear, rj, rejoin, rec, reconnect, walkspeed, jumppower, gravity"))
return
end
if name == "clear" then
KapukaState.consoleOutputLines = {}
if KapukaState.ConsoleOutput then KapukaState.ConsoleOutput.Text = "" end
return
end
if name == "rj" or name == "rejoin" or name == "rec" or name == "reconnect" then
KapukaState.reconnectServer()
return
end
if name == "walkspeed" or name == "ws" then
local value = tonumber(args)
if not value then
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
KapukaState.appendConsoleLine("WalkSpeed: " .. tostring(humanoid and humanoid.WalkSpeed or KapukaState.MovementSettings.WalkSpeed))
return
end
value = math.clamp(math.floor(value + 0.5), 8, 100)
KapukaState.MovementSettings.WalkSpeed = value
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid then humanoid.WalkSpeed = value end
KapukaState.appendConsoleLine("WalkSpeed = " .. tostring(value))
return
end
if name == "jumppower" or name == "jp" then
local value = tonumber(args)
if not value then
KapukaState.appendConsoleLine("JumpPower: " .. tostring(KapukaState.MovementSettings.JumpPower))
return
end
value = math.clamp(math.floor(value + 0.5), 25, 150)
KapukaState.MovementSettings.JumpPower = value
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid then
pcall(function()
humanoid.UseJumpPower = true
humanoid.JumpPower = value
end)
end
KapukaState.appendConsoleLine("JumpPower = " .. tostring(value))
return
end
if name == "gravity" then
local value = tonumber(args)
if not value then
KapukaState.appendConsoleLine("Gravity: " .. tostring(workspace.Gravity))
return
end
value = math.clamp(value, 0, 300)
KapukaState.MovementSettings.Gravity = value
workspace.Gravity = value
KapukaState.appendConsoleLine("Gravity = " .. tostring(value))
return
end
KapukaState.appendConsoleLine(KapukaState.t("Неизвестная команда"))
end

