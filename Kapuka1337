function KapukaState.isValidLockedTarget(part)
if not part or not part.Parent then return false end
local localCharacter = KapukaState.LocalPlayer.Character
local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
local targetRoot = part.Parent:FindFirstChild("HumanoidRootPart")
if KapukaState.AimbotSettings.AimbotDistance > 0 and localRoot and targetRoot and (targetRoot.Position - localRoot.Position).Magnitude > KapukaState.AimbotSettings.AimbotDistance then return false end
local character = part.Parent
local player = KapukaState.Players:GetPlayerFromCharacter(character)
if not player or player == KapukaState.LocalPlayer then return false end
local humanoid = character:FindFirstChildOfClass("Humanoid")
return humanoid ~= nil and humanoid.Health > 0
end
function KapukaState.GetTargetParts(character)
local parts = {}
local seen = {}
local selectedBones = KapukaState.dedupeBoneSelection(KapukaState.AimbotSettings.TargetBones)
KapukaState.AimbotSettings.TargetBones = selectedBones
KapukaState.AimbotSettings.TargetBone = selectedBones[1] or "Head"
for _, boneName in ipairs(selectedBones) do
for _, partName in ipairs(KapukaState.BONE_MAP[boneName] or {}) do
local part = character:FindFirstChild(partName)
if part and not seen[part] then
seen[part] = true
parts[#parts + 1] = part
end
end
end
if #parts == 0 then
local fallback = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
if fallback then parts[1] = fallback end
end
return parts
end
function KapukaState.getCachedTargetParts(player, character)
local cached = KapukaState.targetPartsCache[player]
if cached and cached.Character == character then return cached.Parts end
local parts = KapukaState.GetTargetParts(character)
KapukaState.targetPartsCache[player] = {Character = character, Parts = parts}
return parts
end
function KapukaState.IsWallBetween(Camera, targetPart)
if not targetPart or not targetPart.Parent then return true end
local params = RaycastParams.new()
local filter = {Camera, targetPart.Parent}
if KapukaState.LocalPlayer.Character then filter[#filter + 1] = KapukaState.LocalPlayer.Character end
params.FilterDescendantsInstances = filter
params.FilterType = Enum.RaycastFilterType.Exclude
params.IgnoreWater = true
local result = workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, params)
if result and result.Instance then
return not (result.Instance.Transparency >= 0.7 or not result.Instance.CanCollide)
end
return false
end
function KapukaState.findBestTarget(Camera, radius)
local localCharacter = KapukaState.LocalPlayer.Character
local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
local mousePos = KapukaState.UserInputService:GetMouseLocation()
if mousePos.X <= 0 or mousePos.Y <= 0 then
local vp = Camera.ViewportSize
mousePos = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end
local candidates = {}
local maxDistance = tonumber(KapukaState.AimbotSettings.AimbotDistance) or 0
for _, player in ipairs(KapukaState.Players:GetPlayers()) do
if player == KapukaState.LocalPlayer then continue end
if player.Team and KapukaState.LocalPlayer.Team and player.Team == KapukaState.LocalPlayer.Team then continue end
local char = player.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
local root = char and char:FindFirstChild("HumanoidRootPart")
if hum and root and hum.Health > 0 then
if not (maxDistance > 0 and localRoot and (root.Position - localRoot.Position).Magnitude > maxDistance) then
for _, part in ipairs(KapukaState.getCachedTargetParts(player, char)) do
local p, onScreen = Camera:WorldToViewportPoint(part.Position)
if onScreen and p.Z > 0 then
local screenDistance = (Vector2.new(p.X, p.Y) - mousePos).Magnitude
if screenDistance <= radius then
candidates[#candidates + 1] = {Part = part, Distance = screenDistance}
end
end
end
end
end
end
if #candidates == 0 then return nil end
table.sort(candidates, function(a,b) return a.Distance < b.Distance end)
local checks = math.min(#candidates, 6)
for i = 1, checks do
local candidate = candidates[i]
if KapukaState.AimbotSettings.IgnoreWalls or not KapukaState.IsWallBetween(Camera, candidate.Part) then return candidate.Part end
end
return nil
end
function KapukaState.GetClosestTarget(Camera)
return KapukaState.findBestTarget(Camera, tonumber(KapukaState.AimbotSettings.FOV) or 90)
end
function KapukaState.GetCrosshairTarget(Camera)
return KapukaState.findBestTarget(Camera, 8)
end
function KapukaState.CheckActivation()
if not KapukaState.AimbotSettings.Enabled then return false end
local data = KapukaState.FunctionBinds and KapukaState.FunctionBinds.Aimbot
local mode = data and data.Mode or KapukaState.AimbotSettings.ActivationMode
local bind = data and data.Bind or KapukaState.AimbotSettings.Bind
if mode == "Always" then return true end
if mode == "Toggle" then return (data and data.ToggleState) or KapukaState.AimbotSettings.ToggleState end
if typeof(bind) ~= "EnumItem" then return false end
if bind.EnumType == Enum.KeyCode then return KapukaState.UserInputService:IsKeyDown(bind) end
if bind.EnumType == Enum.UserInputType then
if bind == Enum.UserInputType.MouseButton1 or bind == Enum.UserInputType.MouseButton2 or bind == Enum.UserInputType.MouseButton3 then
return KapukaState.UserInputService:IsMouseButtonPressed(bind)
end
end
return false
end

