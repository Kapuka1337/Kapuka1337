function KapukaState.startPlatform(mode)
KapukaState.stopPlatform()
local character = KapukaState.LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if not root or not humanoid or humanoid.Health <= 0 then
KapukaState.MovementSettings.PlatformMode = "Off"
return
end
KapukaState.MovementSettings.PlatformMode = mode
KapukaState.platformHeight = root.Position.Y - 3.15
KapukaState.platformPart = Instance.new("Part")
KapukaState.platformPart.Name = "KapukaHeightPlatform"
KapukaState.platformPart.Size = Vector3.new(6, 0.35, 6)
KapukaState.platformPart.Anchored = true
KapukaState.platformPart.CanCollide = true
KapukaState.platformPart.CanTouch = false
KapukaState.platformPart.CanQuery = false
KapukaState.platformPart.Material = Enum.Material.SmoothPlastic
KapukaState.platformPart.Color = Color3.fromRGB(75, 75, 90)
KapukaState.platformPart.Transparency = (mode == "Visible") and 0.2 or 1
KapukaState.platformPart.CFrame = CFrame.new(root.Position.X, KapukaState.platformHeight, root.Position.Z)
KapukaState.platformPart.Parent = workspace
KapukaState.platformConnection = KapukaState.RunService.RenderStepped:Connect(function()
if KapukaState.isClosing or KapukaState.MovementSettings.PlatformMode == "Off" or not KapukaState.platformPart or not KapukaState.platformPart.Parent then
KapukaState.stopPlatform()
return
end
local currentCharacter = KapukaState.LocalPlayer.Character
local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
if not currentRoot then
KapukaState.stopPlatform()
return
end
if KapukaState.platformVerticalDirection ~= 0 then
KapukaState.platformHeight = KapukaState.platformHeight + KapukaState.platformVerticalDirection * KapukaState.platformMoveSpeed * math.clamp(1/60, 0, 1)
end
KapukaState.platformPart.Transparency = (KapukaState.MovementSettings.PlatformMode == "Visible") and 0.2 or 1
KapukaState.platformPart.CFrame = CFrame.new(currentRoot.Position.X, KapukaState.platformHeight, currentRoot.Position.Z)
local targetRootY = KapukaState.platformHeight + 3.15
local nextRootY = currentRoot.Position.Y + (targetRootY - currentRoot.Position.Y) * 0.18
if math.abs(nextRootY - currentRoot.Position.Y) > 0.001 then
currentRoot.CFrame = CFrame.new(currentRoot.Position.X, nextRootY, currentRoot.Position.Z) * (currentRoot.CFrame - currentRoot.CFrame.Position)
end
end)
if KapukaState.refreshStatusHUD then KapukaState.refreshStatusHUD() end
end
KapukaState.setPlatformMode = function(mode)
if mode == "Off" then
KapukaState.stopPlatform()
else
KapukaState.startPlatform(mode)
end
if KapukaState.refreshStatusHUD then KapukaState.refreshStatusHUD() end
end
