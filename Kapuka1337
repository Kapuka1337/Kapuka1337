for _, obj in ipairs(player.Character:GetDescendants()) do
if obj:IsA("BasePart") then KapukaState.restorePart(obj) end
end
KapukaState.antiFlingCharacters[player.Character] = nil
end
end)
table.insert(KapukaState.antiFlingConnections, playerRemovingConnection)
end
