if not KapukaState.StatusHUDSettings.Enabled then
KapukaState.StatusFrame.Visible = false
return
end
local enabled = KapukaState.getEnabledFunctionNames()
if #enabled == 0 then
KapukaState.StatusText.Text = KapukaState.t("Нет активных функций")
else
KapukaState.setLocalizedText(KapukaState.StatusText, "ВКЛ:\n• " .. table.concat(enabled, "\n• "))
end
KapukaState.applyStatusHUDPosition()
KapukaState.StatusFrame.Visible = KapukaState.menuUnlocked and not KapukaState.isClosing
end
