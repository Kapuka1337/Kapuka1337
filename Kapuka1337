function KapukaState.normalizeBoneName(name)
if type(name) ~= "string" then return "Head" end
return KapukaState.BoneAliases[name] or name
end

function KapukaState.normalizeBoneSelection(selection)
local result = {}
local seen = {}
if type(selection) == "table" then
for _, rawName in ipairs(selection) do
local name = KapukaState.normalizeBoneName(rawName)
if KapukaState.BONE_MAP[name] and not seen[name] then
seen[name] = true
result[#result + 1] = name
end
end
end
if #result == 0 then result = {"Head"} end
return result
end

function KapukaState.sameBoneTarget(nameA, nameB)
nameA = KapukaState.normalizeBoneName(nameA)
nameB = KapukaState.normalizeBoneName(nameB)
if nameA == nameB then return true end
local partsA = KapukaState.BONE_MAP[nameA] or {}
local partsB = KapukaState.BONE_MAP[nameB] or {}
if #partsA ~= #partsB then return false end
local setB = {}
for _, partName in ipairs(partsB) do setB[partName] = true end
for _, partName in ipairs(partsA) do
if not setB[partName] then return false end
end
return true
end

function KapukaState.dedupeBoneSelection(selection)
local result = {}
if type(selection) ~= "table" then return {"Head"} end
for _, rawName in ipairs(selection) do
local name = KapukaState.normalizeBoneName(rawName)
if KapukaState.BONE_MAP[name] then
local duplicate = false
for _, existing in ipairs(result) do
if KapukaState.sameBoneTarget(existing, name) then
 duplicate = true
 break
end
end
if not duplicate then result[#result + 1] = name end
end
end
if #result == 0 then result = {"Head"} end
return result
end

function KapukaState.setTargetBones(selection)
local normalized = KapukaState.dedupeBoneSelection(selection)
KapukaState.AimbotSettings.TargetBones = normalized
KapukaState.AimbotSettings.TargetBone = normalized[1] or "Head"
end

