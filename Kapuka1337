function KapukaState.applyFunctionState(name, state)
if name == "Aimbot" then
if not KapukaState.AimbotSettings.Enabled then return end
KapukaState.AimbotSettings.ToggleState = state
elseif name == "AntiRecoil" then
KapukaState.AimbotSettings.AntiRecoil = state
elseif name == "Triggerbot" then
KapukaState.AimbotSettings.Triggerbot = state
elseif name == "ShowFOV" then
KapukaState.AimbotSettings.ShowFOV = state
elseif name == "IgnoreWalls" then
KapukaState.AimbotSettings.IgnoreWalls = state
elseif name == "StickyTarget" then
KapukaState.AimbotSettings.StickyTarget = state
if not state then
KapukaState.lockedTargetPart = nil
end
elseif name == "ESP" then
KapukaState.ESPSettings.Enabled = state
elseif name == "Chams" then
KapukaState.ESPSettings.Chams = state
elseif name == "Skeleton" then
KapukaState.ESPSettings.Skeleton = state
elseif name == "Boxes" then
KapukaState.ESPSettings.Boxes = state
elseif name == "InfiniteJump" then
KapukaState.MovementSettings.InfiniteJump = state
elseif name == "AntiFling" then
KapukaState.setAntiFlingEnabled(state)
elseif name == "Fly" then
KapukaState.MovementSettings.Fly = state
if KapukaState.setFlyEnabled then KapukaState.setFlyEnabled(state) end
elseif name == "Noclip" then
KapukaState.MovementSettings.Noclip = state
KapukaState.setNoclip(state)
elseif name == "ClickTP" then
KapukaState.MovementSettings.ClickTP = state
if state then
KapukaState.MovementSettings.ClickFly = false
KapukaState.FunctionBinds.ClickFly.ToggleState = false
end
elseif name == "ClickFly" then
KapukaState.MovementSettings.ClickFly = state
if state then
KapukaState.MovementSettings.ClickTP = false
KapukaState.FunctionBinds.ClickTP.ToggleState = false
else
KapukaState.stopClickFly()
end
elseif name == "Ghost" then
KapukaState.setGhostMode(state)
elseif name == "Sounds" then
KapukaState.MenuSettings.SoundsEnabled = state
elseif name == "StatusHUD" then
KapukaState.StatusHUDSettings.Enabled = state
elseif name == "BunnyHop" then
KapukaState.MovementSettings.BunnyHop = state
elseif name == "CenterMenu" and state then
KapukaState.centerMenu()
end
if KapukaState.refreshStatusHUD then KapukaState.refreshStatusHUD() end
