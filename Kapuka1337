function KapukaState.applyCurrentFont(root)
if not root then return end
local preset = KapukaState.getFontPreset(KapukaState.FontSettings.Preset)
local enumFont
pcall(function() enumFont = Enum.Font[preset.EnumName] end)
local scale = math.clamp(tonumber(KapukaState.FontSettings.TextSize) or 13, 9, 20) / 13
for _, obj in ipairs(root:GetDescendants()) do
if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
local isStatus = KapukaState.StatusFrame and obj:IsDescendantOf(KapukaState.StatusFrame)
local isFontPreview = KapukaState.FontPopup and obj:IsDescendantOf(KapukaState.FontPopup)
if not isStatus and not isFontPreview then
local baseSize = obj:GetAttribute("KapukaBaseTextSize")
if not baseSize then
baseSize = obj.TextSize
obj:SetAttribute("KapukaBaseTextSize", baseSize)
end
obj.TextSize = math.clamp(math.floor(baseSize * scale + 0.5), 8, 32)
if enumFont then pcall(function() obj.Font = enumFont end) end
pcall(function() obj.FontFace = Font.fromName(preset.Family, Enum.FontWeight[preset.Weight] or Enum.FontWeight.Regular, Enum.FontStyle.Normal) end)
end
end
end
end
