end
KapukaState.ghostAnimTracks = {}
end

function KapukaState.loadGhostAnimations(clone)
KapukaState.stopGhostAnimations()
local animator = clone:FindFirstChildWhichIsA("Animator", true)
if not animator then
local humanoid = clone:FindFirstChildOfClass("Humanoid")
if humanoid then
animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
animator.Parent = humanoid
end
end
if not animator then return end
local source = KapukaState.LocalPlayer.Character
if not source then return end
local groups = {idle = {}, walk = {}, run = {}, jump = {}, fall = {}}
for _, obj in ipairs(source:GetDescendants()) do
if obj:IsA("Animation") and obj.AnimationId ~= "" then
local path = obj:GetFullName():lower()
local bucket = path:find("jump") and "jump" or path:find("fall") and "fall" or path:find("walk") and "walk" or path:find("run") and "run" or path:find("idle") and "idle" or nil
if bucket then table.insert(groups[bucket], obj.AnimationId) end
end
end
for name, ids in pairs(groups) do
if #ids > 0 then KapukaState.ghostAnimations[name] = ids end
end
end

function KapukaState.playGhostAnimation(name)
local ids = KapukaState.ghostAnimations[name]
if not ids or #ids == 0 then return end
local animator = KapukaState.ghostClone and KapukaState.ghostClone:FindFirstChildWhichIsA("Animator", true)
if not animator then return end
local wanted = name .. "Track"
if KapukaState.ghostAnimTracks[wanted] then return end
local animation = Instance.new("Animation")
animation.AnimationId = ids[1]
local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
animation:Destroy()
if ok and track then
track.Looped = name ~= "jump" and name ~= "fall"
track.Priority = Enum.AnimationPriority.Movement
track:Play(0.12, 1, 1)
KapukaState.ghostAnimTracks[wanted] = track
end
end

function KapukaState.setGhostAnimation(name, speed)
for key, track in pairs(KapukaState.ghostAnimTracks) do
local activeName = key:gsub("Track$", "")
if activeName ~= name then
pcall(function() track:Stop(0.12) end)
KapukaState.ghostAnimTracks[key] = nil
end
end
KapukaState.playGhostAnimation(name)
local track = KapukaState.ghostAnimTracks[name .. "Track"]
if track then pcall(function() track:AdjustSpeed(speed or 1) end) end
end

function KapukaState.ghostRaycast(origin, direction, excludeCharacters)
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.IgnoreWater = false
local filter = {KapukaState.ghostClone, KapukaState.LocalPlayer.Character}
if excludeCharacters then
for _, player in ipairs(KapukaState.Players:GetPlayers()) do
if player.Character then table.insert(filter, player.Character) end
end
end
params.FilterDescendantsInstances = filter
return workspace:Raycast(origin, direction, params)
end

function KapukaState.stopGhostMode()
if KapukaState.ghostJumpConnection then KapukaState.ghostJumpConnection:Disconnect(); KapukaState.ghostJumpConnection = nil end
if KapukaState.ghostRenderConnection then KapukaState.ghostRenderConnection:Disconnect(); KapukaState.ghostRenderConnection = nil end
local character = KapukaState.LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
local camera = KapukaState.GetCamera()
local clone = KapukaState.ghostClone
local targetPivot = clone and clone.Parent and clone:GetPivot() or KapukaState.ghostOriginalRootCFrame
if root and targetPivot then
root.Anchored = false
root.CFrame = targetPivot
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
end
if humanoid then
pcall(function()
humanoid.AutoRotate = true
humanoid.PlatformStand = false
humanoid.WalkSpeed = KapukaState.MovementSettings.WalkSpeed
humanoid.UseJumpPower = true
humanoid.JumpPower = KapukaState.MovementSettings.JumpPower
humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
end)
end
KapukaState.stopGhostAnimations()
if clone then pcall(function() clone:Destroy() end) end
KapukaState.ghostClone = nil
if camera then
pcall(function()
camera.CameraType = Enum.CameraType.Custom
if humanoid then camera.CameraSubject = humanoid end
end)
end
KapukaState.ghostOriginalCameraCFrame = nil
KapukaState.ghostOriginalCameraType = nil
KapukaState.ghostOriginalCameraSubject = nil
KapukaState.ghostOriginalRootCFrame = nil
KapukaState.ghostVerticalVelocity = 0
KapukaState.ghostGrounded = false
KapukaState.ghostJumpQueued = false
end

function KapukaState.ghostCanCollideWithWorld(origin, size, direction)
if direction.Magnitude <= 0.001 then return nil end
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.IgnoreWater = false
local filter = {KapukaState.ghostClone, KapukaState.LocalPlayer.Character}
for _, player in ipairs(KapukaState.Players:GetPlayers()) do
if player.Character then table.insert(filter, player.Character) end
end
params.FilterDescendantsInstances = filter
local cf = CFrame.lookAt(origin, origin + direction)
return workspace:Blockcast(cf, size, direction, params)
end

function KapukaState.startGhostMode()
KapukaState.stopGhostMode()
local character = KapukaState.LocalPlayer.Character
local root = character and character:FindFirstChild("HumanoidRootPart")
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if not character or not root or not humanoid or humanoid.Health <= 0 then return false end
character.Archivable = true
local clone = character:Clone()
if not clone then return false end
clone.Name = "KapukaGhostVisual"
clone.Parent = workspace
clone:PivotTo(character:GetPivot())
for _, obj in ipairs(clone:GetDescendants()) do
if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
obj:Destroy()
elseif obj:IsA("BasePart") then
obj.Anchored = true
obj.CanTouch = false
obj.CanQuery = false
obj.CanCollide = KapukaState.MovementSettings.GhostCollision
obj.Massless = true
end
end
local ghostHumanoid = clone:FindFirstChildOfClass("Humanoid")
local ghostRoot = clone:FindFirstChild("HumanoidRootPart")
if not ghostHumanoid or not ghostRoot then clone:Destroy(); return false end
pcall(function()
ghostHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
ghostHumanoid.AutoRotate = false
ghostHumanoid.PlatformStand = true
ghostHumanoid.UseJumpPower = true
ghostHumanoid.WalkSpeed = 0
ghostHumanoid.JumpPower = 0
end)
KapukaState.ghostClone = clone
KapukaState.ghostOriginalRootCFrame = root.CFrame
KapukaState.ghostVerticalVelocity = 0
KapukaState.ghostGrounded = false
KapukaState.ghostJumpQueued = false
KapukaState.loadGhostAnimations(clone)
KapukaState.setGhostAnimation("idle", 1)
local camera = KapukaState.GetCamera()
if camera then
KapukaState.ghostOriginalCameraCFrame = camera.CFrame
KapukaState.ghostOriginalCameraType = camera.CameraType
KapukaState.ghostOriginalCameraSubject = camera.CameraSubject
pcall(function()
camera.CameraType = Enum.CameraType.Custom
camera.CameraSubject = ghostHumanoid
end)
end
root.Anchored = true
humanoid.AutoRotate = false
humanoid.PlatformStand = false
KapukaState.ghostJumpConnection = KapukaState.UserInputService.JumpRequest:Connect(function()
if KapukaState.MovementSettings.Ghost and KapukaState.MovementSettings.GhostGravity then
KapukaState.ghostJumpQueued = true
end
end)
KapukaState.ghostRenderConnection = KapukaState.RunService.RenderStepped:Connect(function(dt)
if KapukaState.isClosing or not KapukaState.MovementSettings.Ghost then
KapukaState.stopGhostMode(); return
end
local activeCharacter = KapukaState.LocalPlayer.Character
if activeCharacter ~= character or not KapukaState.ghostClone or not KapukaState.ghostClone.Parent then
KapukaState.stopGhostMode(); return
end
local currentCamera = KapukaState.GetCamera()
local ghostRootPart = KapukaState.ghostClone:FindFirstChild("HumanoidRootPart")
if not currentCamera or not ghostRootPart then KapukaState.stopGhostMode(); return end
local look3 = currentCamera.CFrame.LookVector
local right3 = currentCamera.CFrame.RightVector
local look = Vector3.new(look3.X, 0, look3.Z)
local right = Vector3.new(right3.X, 0, right3.Z)
if look.Magnitude < 0.001 then look = Vector3.new(0,0,-1) else look = look.Unit end
if right.Magnitude < 0.001 then right = Vector3.new(1,0,0) else right = right.Unit end
local direction = Vector3.zero
local uis = KapukaState.UserInputService
if uis:IsKeyDown(Enum.KeyCode.W) then direction += look end
if uis:IsKeyDown(Enum.KeyCode.S) then direction -= look end
if uis:IsKeyDown(Enum.KeyCode.A) then direction -= right end
if uis:IsKeyDown(Enum.KeyCode.D) then direction += right end
local moving = direction.Magnitude > 0.001
if moving then direction = direction.Unit end
local currentPivot = KapukaState.ghostClone:GetPivot()
local currentPos = currentPivot.Position
local vertical = KapukaState.ghostVerticalVelocity
local gravity = 196.2
if KapukaState.MovementSettings.GhostGravity then
if KapukaState.ghostJumpQueued and KapukaState.ghostGrounded then
vertical = math.max(KapukaState.MovementSettings.GhostJumpPower, 35)
KapukaState.ghostGrounded = false
KapukaState.ghostJumpQueued = false
end
vertical -= gravity * dt
else
vertical = 0
KapukaState.ghostJumpQueued = false
KapukaState.ghostGrounded = false
end
local horizontalStep = direction * KapukaState.MovementSettings.GhostSpeed * dt
local verticalStep = Vector3.new(0, vertical * dt, 0)
local newPos = currentPos + horizontalStep + verticalStep
local rootSize = Vector3.new(math.max(ghostRootPart.Size.X, 2), math.max(ghostRootPart.Size.Y, 3), math.max(ghostRootPart.Size.Z, 2))
if KapukaState.MovementSettings.GhostCollision then
if horizontalStep.Magnitude > 0.001 then
local hit = KapukaState.ghostCanCollideWithWorld(currentPos, rootSize, horizontalStep)
if hit then newPos = Vector3.new(hit.Position.X - direction.X * rootSize.X * 0.55, newPos.Y, hit.Position.Z - direction.Z * rootSize.Z * 0.55) end
end
if KapukaState.MovementSettings.GhostGravity and vertical <= 0 then
local down = KapukaState.ghostCanCollideWithWorld(newPos, rootSize, Vector3.new(0, verticalStep.Y - math.max(5 * dt, 0.5), 0))
if down then
local groundY = down.Position.Y + rootSize.Y * 0.5
if newPos.Y <= groundY then
newPos = Vector3.new(newPos.X, groundY, newPos.Z)
vertical = 0
KapukaState.ghostGrounded = true
else
KapukaState.ghostGrounded = false
end
else
KapukaState.ghostGrounded = false
end
end
end
if moving then
KapukaState.ghostClone:PivotTo(CFrame.lookAt(newPos, newPos + direction, Vector3.new(0,1,0)))
else
KapukaState.ghostClone:PivotTo(CFrame.new(newPos) * (currentPivot - currentPos))
end
KapukaState.ghostVerticalVelocity = vertical
if KapukaState.MovementSettings.GhostGravity and not KapukaState.ghostGrounded and vertical > 0 then
KapukaState.setGhostAnimation("jump", 1)
elseif KapukaState.MovementSettings.GhostGravity and not KapukaState.ghostGrounded and vertical < 0 then
KapukaState.setGhostAnimation("fall", 1)
elseif moving then
KapukaState.setGhostAnimation("walk", 1)
else
KapukaState.setGhostAnimation("idle", 1)
end
end)
return true
end

KapukaState.setGhostMode = function(enabled)
KapukaState.MovementSettings.Ghost = enabled
if enabled then
return KapukaState.startGhostMode()
end
KapukaState.stopGhostMode()
return true
end

