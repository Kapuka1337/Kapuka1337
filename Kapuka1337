name = KapukaState.safeConfigName(name)
local path = KapukaState.configPath(name)
if not isfile(path) then return false, "Конфиг не найден" end
local okRead, raw = pcall(function() return readfile(path) end)
if not okRead then return false, "Не удалось прочитать файл" end
local okDecode, data = pcall(function() return KapukaState.HttpService:JSONDecode(raw) end)
if not okDecode then return false, "Конфиг повреждён" end
KapukaState.ConfigOptions._loading = true
local applied = KapukaState.applyConfigData(data)
KapukaState.ConfigOptions._loading = false
if KapukaState.FunctionBinds and KapukaState.FunctionBinds.Aimbot then
KapukaState.AimbotSettings.Bind = KapukaState.FunctionBinds.Aimbot.Bind
KapukaState.AimbotSettings.BindName = KapukaState.FunctionBinds.Aimbot.BindName
KapukaState.AimbotSettings.ActivationMode = KapukaState.FunctionBinds.Aimbot.Mode
end
if not applied then return false, "Неверный формат конфига" end
KapukaState.currentConfigName = name
return true, path
end
function KapukaState.deleteConfigFile(name)
if not KapukaState.fsAvailable() then return false, "Файловая система executor недоступна" end
local path = KapukaState.configPath(name)
if not isfile(path) then return false, "Конфиг не найден" end
local ok = pcall(function() delfile(path) end)
return ok, ok and path or "Не удалось удалить файл"
end
function KapukaState.listConfigFiles()
if type(listfiles) ~= "function" then return {} end
KapukaState.ensureConfigFolder()
local result = {}
local ok, files = pcall(function() return listfiles(KapukaState.CONFIG_FOLDER) end)
if not ok or type(files) ~= "table" then return result end
for _, path in ipairs(files) do
local name = tostring(path):match("([^/\\]+)%.json$")
if name then table.insert(result, name) end
end
table.sort(result, function(a, b) return a:lower() < b:lower() end)
return result
end
if KapukaState.fsAvailable() then
pcall(function() KapukaState.loadConfigFile(KapukaState.DEFAULT_CONFIG_NAME) end)
end
