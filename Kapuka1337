function KapukaState.performAntiAFKAction()
if KapukaState.isClosing or not KapukaState.AntiAFKSettings.Enabled then return end
if KapukaState.AntiAFKSettings.PauseWhileTyping and KapukaState.UserInputService:GetFocusedTextBox() then return end
local mode = KapukaState.AntiAFKSettings.Mode
if mode == "VirtualUser" or mode == "Mixed" then
pcall(function()
KapukaState.VirtualUser:CaptureController()
KapukaState.VirtualUser:ClickButton2(Vector2.new(0, 0))
end)
end
if mode == "Move" or mode == "Mixed" then
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid and humanoid.Health > 0 and KapukaState.AntiAFKSettings.MovePulse then
local dir = Vector3.new(1, 0, 0)
pcall(function() humanoid:Move(dir, true) end)
task.wait(0.12)
pcall(function() humanoid:Move(Vector3.zero, true) end)
end
end
if KapukaState.AntiAFKSettings.JumpPulse then
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
if humanoid and humanoid.Health > 0 then pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end) end
end
if KapukaState.AntiAFKSettings.CameraNudge then
local camera = KapukaState.GetCamera()
if camera then
local original = camera.CFrame
pcall(function() camera.CFrame = original * CFrame.Angles(0, math.rad(0.7), 0) end)
task.delay(0.15, function()
if camera and camera.Parent and not KapukaState.isClosing and not KapukaState.StreamerSettings.Enabled then pcall(function() camera.CFrame = original end) end
end)
end
end
end

function KapukaState.stopAntiAFK()
KapukaState.antiAFKToken += 1
if KapukaState.antiAFKConnection then
pcall(function() KapukaState.antiAFKConnection:Disconnect() end)
KapukaState.antiAFKConnection = nil
end
end

function KapukaState.startAntiAFK()
KapukaState.stopAntiAFK()
if not KapukaState.AntiAFKSettings.Enabled then return end
local token = KapukaState.antiAFKToken
if KapukaState.AntiAFKSettings.UseIdledEvent then
KapukaState.antiAFKConnection = KapukaState.LocalPlayer.Idled:Connect(function()
if token == KapukaState.antiAFKToken then KapukaState.performAntiAFKAction() end
end)
end
task.spawn(function()
while token == KapukaState.antiAFKToken and KapukaState.AntiAFKSettings.Enabled and not KapukaState.isClosing do
local interval = math.max(15, tonumber(KapukaState.AntiAFKSettings.Interval) or 60)
if KapukaState.AntiAFKSettings.Randomize then
local minValue = math.min(tonumber(KapukaState.AntiAFKSettings.RandomMin) or 45, tonumber(KapukaState.AntiAFKSettings.RandomMax) or 90)
local maxValue = math.max(tonumber(KapukaState.AntiAFKSettings.RandomMin) or 45, tonumber(KapukaState.AntiAFKSettings.RandomMax) or 90)
interval = math.random(math.floor(minValue), math.floor(maxValue))
end
task.wait(interval)
if token == KapukaState.antiAFKToken and KapukaState.AntiAFKSettings.Enabled then KapukaState.performAntiAFKAction() end
end
end)
end

