KapukaState.antiFlingOriginalCanCollide[part] = part.CanCollide
end
end
function KapukaState.protectPart(part, groupName)
if not KapukaState.MovementSettings.AntiFling then return end
if not part:IsA("BasePart") then return end
KapukaState.rememberCanCollide(part)
if KapukaState.antiFlingOriginalGroups[part] == nil then
KapukaState.antiFlingOriginalGroups[part] = part.CollisionGroup
end
pcall(function()
part.CollisionGroup = groupName or KapukaState.antiFlingPlayerGroup
part.CanCollide = false
end)
end
function KapukaState.restorePart(part)
local original = KapukaState.antiFlingOriginalCanCollide[part]
if original ~= nil and part and part.Parent then
pcall(function() part.CanCollide = original end)
end
local originalGroup = KapukaState.antiFlingOriginalGroups[part]
if originalGroup ~= nil and part and part.Parent then
pcall(function() part.CollisionGroup = originalGroup end)
end
KapukaState.antiFlingOriginalCanCollide[part] = nil
KapukaState.antiFlingOriginalGroups[part] = nil
end
function KapukaState.protectCharacter(character)
if not character or KapukaState.antiFlingCharacters[character] then return end
KapukaState.antiFlingCharacters[character] = true
for _, obj in ipairs(character:GetDescendants()) do
KapukaState.protectPart(obj, KapukaState.antiFlingPlayerGroup)
end
local descendantConnection = character.DescendantAdded:Connect(function(obj)
if KapukaState.MovementSettings.AntiFling then
KapukaState.protectPart(obj, KapukaState.antiFlingPlayerGroup)
end
end)
table.insert(KapukaState.antiFlingConnections, descendantConnection)
end
