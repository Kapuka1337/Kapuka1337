function KapukaState.getEnabledFunctionNames()
local enabled = {}
if KapukaState.AimbotSettings.Enabled then table.insert(enabled, KapukaState.t("Аимбот")) end
if KapukaState.AimbotSettings.IgnoreWalls then table.insert(enabled, KapukaState.t("Сквозь стены")) end
if KapukaState.AimbotSettings.StickyTarget then table.insert(enabled, KapukaState.t("Захват цели")) end
if KapukaState.ESPSettings.Enabled then table.insert(enabled, "ESP") end
if KapukaState.MovementSettings.InfiniteJump then table.insert(enabled, KapukaState.t("Бесконечный прыжок")) end
if KapukaState.MovementSettings.AntiFling then table.insert(enabled, "Anti Fling") end
if KapukaState.MovementSettings.Fly then table.insert(enabled, KapukaState.t("Железный Флай")) end
if KapukaState.MovementSettings.Noclip then table.insert(enabled, "Noclip") end
if KapukaState.MovementSettings.ClickTP then table.insert(enabled, KapukaState.t("Клик ТП")) end
if KapukaState.MovementSettings.ClickFly then table.insert(enabled, KapukaState.t("Клик Флай")) end
if KapukaState.MovementSettings.Ghost then table.insert(enabled, KapukaState.t("Призрачный режим")) end
if KapukaState.MovementSettings.BunnyHop then table.insert(enabled, KapukaState.t("Баннихоп")) end
if KapukaState.AntiAFKSettings.Enabled then table.insert(enabled, KapukaState.t("Анти AFK")) end
if KapukaState.MovementSettings.PlatformMode ~= "Off" then
table.insert(enabled, KapukaState.t(KapukaState.MovementSettings.PlatformMode == "Visible" and "Платформа" or "Платформа (скрытая)"))
end
return enabled
end
KapukaState.refreshStatusHUD = function()
KapukaState.StatusText.TextSize = KapukaState.StatusHUDSettings.TextSize
KapukaState.StatusText.Font = Enum.Font.GothamBold
