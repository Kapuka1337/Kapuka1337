local function GetTargetParts(character)
local parts = {}
local boneMap = {
["Голова"] = {"Head"},
["Торс"] = {"HumanoidRootPart", "Torso", "UpperTorso"},
["Руки"] = {"Right Arm", "Left Arm", "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm"},
["Ноги"] = {"Right Leg", "Left Leg", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg"}
}

if AimbotSettings.TargetBone == "Ближайшая" then
    for _, list in pairs(boneMap) do
        for _, v in ipairs(list) do
            if character:FindFirstChild(v) then table.insert(parts, character[v]) end
        end
    end
else
    for _, v in ipairs(boneMap[AimbotSettings.TargetBone] or {}) do
        if character:FindFirstChild(v) then table.insert(parts, character[v]) end
    end
end
return parts


end

local function IsWallBetween(targetPos)
local raycastParams = RaycastParams.new()
raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
raycastParams.IgnoreWater = true
local rayResult = game.Workspace:Raycast(Camera.CFrame.Position, targetPos - Camera.CFrame.Position, raycastParams)

if rayResult and rayResult.Instance then
    if not rayResult.Instance:IsDescendantOf(game.Workspace) then return true end
    local character = rayResult.Instance:FindFirstAncestorOfClass("Model")
    if character and Players:GetPlayerFromCharacter(character) then return false end
    return true
end
return false


end

local function GetClosestTarget()
local closestPart = nil
local shortestDistance = AimbotSettings.FOV
local mousePos = UserInputService:GetMouseLocation()

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
        if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
        
        local partsToCheck = GetTargetParts(player.Character)
        
        for _, part in ipairs(partsToCheck) do
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            
            if onScreen then
                local distance = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if distance < shortestDistance then
                    if not IsWallBetween(part.Position) then
                        closestPart = part
                        shortestDistance = distance
                    end
                end
            end
        end
    end
end
return closestPart


end

local function CheckActivation()
if not AimbotSettings.Enabled then return false end

if AimbotSettings.ActivationMode == "Always" then
    return true
elseif AimbotSettings.ActivationMode == "Hold" then
    local bType = typeof(AimbotSettings.Bind)
    if bType == "EnumItem" then
        if AimbotSettings.Bind.EnumType == Enum.KeyCode then
            return UserInputService:IsKeyDown(AimbotSettings.Bind)
        elseif AimbotSettings.Bind.EnumType == Enum.UserInputType then
            local validMouse = {
                [Enum.UserInputType.MouseButton1] = true,
                [Enum.UserInputType.MouseButton2] = true,
                [Enum.UserInputType.MouseButton3] = true
            }
            if validMouse[AimbotSettings.Bind] then
                return UserInputService:IsMouseButtonPressed(AimbotSettings.Bind)
            end
        end
    end
elseif AimbotSettings.ActivationMode == "Toggle" then
    return AimbotSettings.ToggleState
end
return false


end

-- STREAMING_CHUNK:Главный цикл отрисовки
table.insert(getgenv().KapukaConnections, RunService.RenderStepped:Connect(function()
if isClosing then return end
UpdateESP()

if FOVCircle then
    if AimbotSettings.ShowFOV and AimbotSettings.Enabled then
        FOVCircle.Visible = true
        FOVCircle.Radius = AimbotSettings.FOV
        FOVCircle.Position = UserInputService:GetMouseLocation()
    else
        FOVCircle.Visible = false
    end
end

if CheckActivation() then
    local targetPart = GetClosestTarget()
    
    if targetPart then
        local targetPos = targetPart.Position
        
        if targetPart.Parent and targetPart.Parent:FindFirstChild("HumanoidRootPart") then
            targetPos = targetPos + (targetPart.Parent.HumanoidRootPart.Velocity * 0.035) 
        end
        
        local lookAt = CFrame.new(Camera.CFrame.Position, targetPos)
        
        if AimbotSettings.Smoothness > 1 then
            local lerpSpeed = math.clamp(1 / AimbotSettings.Smoothness, 0.05, 1)
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, lerpSpeed)
        else
            Camera.CFrame = lookAt
        end
    end
end


end))
