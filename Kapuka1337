function KapukaState.saveConfigFile(name)
if not KapukaState.fsAvailable() then return false, "Файловая система executor недоступна" end
KapukaState.ensureConfigFolder()
name = KapukaState.safeConfigName(name)
KapukaState.currentConfigName = name
local okEncode, json = pcall(function() return KapukaState.HttpService:JSONEncode(KapukaState.buildConfigData()) end)
if not okEncode then return false, "JSONEncode не сработал" end
local okWrite = pcall(function() writefile(KapukaState.configPath(name), json) end)
if not okWrite then return false, "Не удалось записать файл" end
return true, KapukaState.configPath(name)
end
