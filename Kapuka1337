function KapukaState.startFlight()
KapukaState.stopFlight()
local character, humanoid, root = KapukaState.getFlightCharacter()
if not character or not humanoid or not root or humanoid.Health <= 0 then
return
end
KapukaState.rememberFlightMotors(character)
KapukaState.disableFlightAnimation(character)
KapukaState.flightOriginalJumpPower = humanoid.JumpPower
KapukaState.flightOriginalJumpHeight = humanoid.JumpHeight
humanoid.AutoRotate = false
