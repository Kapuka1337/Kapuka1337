KapukaState.startClickFly = function(targetPosition)
KapukaState.stopClickFly()
local character = KapukaState.LocalPlayer.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")
local root = character and character:FindFirstChild("HumanoidRootPart")
if not character or not humanoid or not root or humanoid.Health <= 0 then return end
KapukaState.clickFlyTarget = targetPosition + Vector3.new(0, 2.5, 0)
if KapukaState.MovementSettings.ClickFlyNoclip and not KapukaState.MovementSettings.Noclip then
KapukaState.clickFlyTemporaryNoclip = true
KapukaState.setNoclip(true)
end
local bv = Instance.new("BodyVelocity")
bv.Name = "KapukaClickFlyVelocity"
bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
bv.P = 5000
bv.Velocity = Vector3.zero
bv.Parent = root
KapukaState.clickFlyBodyVelocity = bv
local currentVelocity = root.AssemblyLinearVelocity
KapukaState.clickFlyConnection = KapukaState.RunService.Heartbeat:Connect(function(dt)
if KapukaState.isClosing or not KapukaState.clickFlyTarget or not root.Parent then
KapukaState.stopClickFly()
return
end
local offset = KapukaState.clickFlyTarget - root.Position
local distance = offset.Magnitude
if distance <= 3 then
KapukaState.stopClickFly()
return
end
local direction = offset.Unit
local targetVelocity = direction * KapukaState.MovementSettings.ClickFlySpeed
local blend = 1 - math.exp(-7 * dt)
currentVelocity = currentVelocity:Lerp(targetVelocity, blend)
bv.Velocity = currentVelocity
root.CFrame = CFrame.lookAt(root.Position, root.Position + direction, Vector3.new(0, 1, 0))
end)
end
