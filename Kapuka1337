local function ensureDrawing(cache, key, creator)
if not Drawing then return nil end
if not cache[key] then cache[key] = creator() end
return cache[key]
end
local function updateHighlight(cache, key, character, enabled, color, alwaysOnTop, fillTransparency, outlineTransparency)
local current = cache[key]
if enabled then
if not current or not current.Parent then
current = Instance.new("Highlight")
current.Name = key == "Chams" and "KapukaChams" or "KapukaGlow"
current.Parent = character
current.DepthMode = alwaysOnTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
cache[key] = current
end
current.Enabled = true
if cache[key .. "Color"] ~= color or cache[key .. "FillTransparency"] ~= fillTransparency or cache[key .. "OutlineTransparency"] ~= outlineTransparency then
current.FillColor = color
current.OutlineColor = color
current.FillTransparency = fillTransparency
current.OutlineTransparency = outlineTransparency
cache[key .. "Color"] = color
cache[key .. "FillTransparency"] = fillTransparency
cache[key .. "OutlineTransparency"] = outlineTransparency
end
else
if current then
pcall(function() current:Destroy() end)
cache[key] = nil
cache[key .. "Color"] = nil
end
end
end
function KapukaState.UpdateESP(Camera)
if not Camera then return end
local enabled = KapukaState.ESPSettings.Enabled and not KapukaState.StreamerSettings.Enabled
if not enabled then
if not KapukaState._espWasEnabled then return end
for _, cache in pairs(KapukaState.espCache) do KapukaState.hideESPCache(cache) end
for player, cache in pairs(KapukaState.espCache) do
if cache.Chams then pcall(function() cache.Chams:Destroy() end); cache.Chams = nil end
if cache.Glow then pcall(function() cache.Glow:Destroy() end); cache.Glow = nil end
end
KapukaState._espWasEnabled = false
return
end
KapukaState._espWasEnabled = true
local now = os.clock()
local localCharacter = KapukaState.LocalPlayer.Character
local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
local maxDistance = tonumber(KapukaState.ESPSettings.ESPDistance) or 0
for _, player in ipairs(KapukaState.Players:GetPlayers()) do
if player == KapukaState.LocalPlayer then continue end
local char = player.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
local hrp = char and char:FindFirstChild("HumanoidRootPart")
if not char or not hum or hum.Health <= 0 or not hrp then
local oldCache = KapukaState.espCache[player]
if oldCache then
KapukaState.hideESPCache(oldCache)
if oldCache.Chams then oldCache.Chams.Enabled = false end
if oldCache.Glow then oldCache.Glow.Enabled = false end
end
continue
end
if maxDistance > 0 and localRoot and (hrp.Position - localRoot.Position).Magnitude > maxDistance then
local oldCache = KapukaState.espCache[player]
if oldCache then
KapukaState.hideESPCache(oldCache)
if oldCache.Chams then oldCache.Chams.Enabled = false end
if oldCache.Glow then oldCache.Glow.Enabled = false end
end
continue
end
local cache = KapukaState.espCache[player]
if not cache then
cache = createEspCache()
KapukaState.espCache[player] = cache
end
local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
local needsVisibilityColor = KapukaState.ESPSettings.Chams
or KapukaState.ESPSettings.Glow
or KapukaState.ESPSettings.Boxes
or KapukaState.ESPSettings.Skeleton
or KapukaState.ESPSettings.ShowNames
or KapukaState.ESPSettings.Distance
or KapukaState.ESPSettings.Tracers
or KapukaState.ESPSettings.OffscreenArrows
