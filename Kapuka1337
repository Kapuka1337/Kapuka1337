if not KapukaState.MovementSettings.AntiFling then return end
KapukaState.setupAntiFlingCollisionGroups()
if KapukaState.LocalPlayer.Character then
KapukaState.protectLocalCharacter(KapukaState.LocalPlayer.Character)
end
for _, player in ipairs(KapukaState.Players:GetPlayers()) do
if player ~= KapukaState.LocalPlayer then
if player.Character then
KapukaState.protectCharacter(player.Character)
end
local characterConnection = player.CharacterAdded:Connect(function(character)
if KapukaState.MovementSettings.AntiFling then
KapukaState.protectCharacter(character)
end
end)
table.insert(KapukaState.antiFlingConnections, characterConnection)
end
end
local playerAddedConnection = KapukaState.Players.PlayerAdded:Connect(function(player)
if not KapukaState.MovementSettings.AntiFling or player == KapukaState.LocalPlayer then return end
if player.Character then KapukaState.protectCharacter(player.Character) end
local characterConnection = player.CharacterAdded:Connect(function(character)
if KapukaState.MovementSettings.AntiFling then
KapukaState.protectCharacter(character)
end
end)
table.insert(KapukaState.antiFlingConnections, characterConnection)
end)
table.insert(KapukaState.antiFlingConnections, playerAddedConnection)
local playerRemovingConnection = KapukaState.Players.PlayerRemoving:Connect(function(player)
