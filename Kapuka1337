function KapukaState.colorToTable(color)
return {r = color.R, g = color.G, b = color.B}
end
function KapukaState.tableToColor(value, fallback)
if type(value) ~= "table" then return fallback end
local r = tonumber(value.r)
local g = tonumber(value.g)
local b = tonumber(value.b)
if not r or not g or not b then return fallback end
return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end
function KapukaState.bindToTable(bind)
if typeof(bind) ~= "EnumItem" then return nil end
if bind.EnumType == Enum.KeyCode then
return {Type = "KeyCode", Name = bind.Name}
elseif bind.EnumType == Enum.UserInputType then
return {Type = "UserInputType", Name = bind.Name}
end
return nil
end
function KapukaState.tableToBind(value)
if type(value) ~= "table" or type(value.Name) ~= "string" then return nil end
local enumType = value.Type
if enumType == "KeyCode" then
local ok, result = pcall(function() return Enum.KeyCode[value.Name] end)
return ok and result or nil
elseif enumType == "UserInputType" then
local ok, result = pcall(function() return Enum.UserInputType[value.Name] end)
return ok and result or nil
end
return nil
end
