local function ClearESP(player)
if espCache[player] then
for _, obj in pairs(espCache[player].SkeletonLines) do SafeRemoveDrawing(obj) end
if espCache[player].Box then SafeRemoveDrawing(espCache[player].Box) end
espCache[player] = nil
end
if player.Character and player.Character:FindFirstChild("KapukaChams") then
player.Character.KapukaChams:Destroy()
end
end

getgenv().ClearKapukaESP = function()
for _, player in ipairs(Players:GetPlayers()) do ClearESP(player) end
end

table.insert(getgenv().KapukaConnections, Players.PlayerRemoving:Connect(function(player) ClearESP(player) end))

local function UpdateESP()
for _, player in ipairs(Players:GetPlayers()) do
if player == LocalPlayer then continue end
local char = player.Character
if not char then
ClearESP(player)
continue
end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not (hrp and hum and hum.Health > 0) or not ESPSettings.Enabled then
        ClearESP(player)
        continue
    end
    
    if not espCache[player] then
        espCache[player] = { SkeletonLines = {}, Box = CreateBox() }
    end
    
    local cache = espCache[player]
    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    
    -- Чамсы
    local chams = char:FindFirstChild("KapukaChams")
    if ESPSettings.Chams then
        if not chams then
            chams = Instance.new("Highlight")
            chams.Name = "KapukaChams"
            chams.Parent = char
            chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end
        chams.FillColor = ESPSettings.ChamsColor
        chams.OutlineColor = Color3.new(1, 1, 1)
    else
        if chams then chams:Destroy() end
    end
    
    if not Drawing then continue end
    
    if not onScreen then
        if cache.Box then cache.Box.Visible = false end
        for _, line in pairs(cache.SkeletonLines) do line.Visible = false end
        continue
    end
    
    -- Боксы
    if ESPSettings.Boxes and cache.Box then
        local head = char:FindFirstChild("Head")
        if head then
            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            local height = math.abs(headPos.Y - legPos.Y)
            local width = height / 2
            
            cache.Box.Size = Vector2.new(width, height)
            cache.Box.Position = Vector2.new(hrpPos.X - width/2, headPos.Y)
            cache.Box.Color = ESPSettings.BoxColor
            cache.Box.Visible = true
        else
            cache.Box.Visible = false
        end
    elseif cache.Box then
        cache.Box.Visible = false
    end
    
    -- Скелет
    if ESPSettings.Skeleton then
        local isR15 = char:FindFirstChild("UpperTorso") ~= nil
        local boneMap = isR15 and R15Bones or R6Bones
        
        for i, connection in ipairs(boneMap) do
            local part1 = char:FindFirstChild(connection[1])
            local part2 = char:FindFirstChild(connection[2])
            
            if not cache.SkeletonLines[i] then cache.SkeletonLines[i] = CreateLine() end
            local line = cache.SkeletonLines[i]
            
            if part1 and part2 then
                local p1, vis1 = Camera:WorldToViewportPoint(part1.Position)
                local p2, vis2 = Camera:WorldToViewportPoint(part2.Position)
                
                if vis1 or vis2 then
                    line.From = Vector2.new(p1.X, p1.Y)
                    line.To = Vector2.new(p2.X, p2.Y)
                    line.Color = ESPSettings.SkeletonColor
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
        
        for i = #boneMap + 1, #cache.SkeletonLines do
            cache.SkeletonLines[i].Visible = false
        end
    else
        for _, line in pairs(cache.SkeletonLines) do
            line.Visible = false
        end
    end
end


end

