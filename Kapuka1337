KapukaState.LocalizedObjects = {}
KapukaState.DynamicRefreshers = {}
function KapukaState.t(text)
if KapukaState.LanguageSettings.Current ~= "en" then return text end
return KapukaState.Translations[text] or text
end
function KapukaState.reverseTranslate(text)
if type(text) ~= "string" then return text end
for ru, en in pairs(KapukaState.Translations) do
if text == en then return ru end
end
return text
end
function KapukaState.translateDynamic(text)
if type(text) ~= "string" then return text end
if KapukaState.LanguageSettings.Current == "en" then
local prefix = {
{"Файл: ", "File: "}, {"Сохранено: ", "Saved: "}, {"Ошибка: ", "Error: "}, {"Загружено: ", "Loaded: "},
{"Переименовано в ", "Renamed to "}, {"Удалён: ", "Deleted: "}, {"Папка: ", "Folder: "}, {"Выбрано: ", "Selected: "}
}
for _, pair in ipairs(prefix) do
if text:sub(1, #pair[1]) == pair[1] then return pair[2] .. text:sub(#pair[1] + 1) end
end
return KapukaState.Translations[text] or text
end
return text
end
function KapukaState.registerLocalizedObject(obj, raw, formatter)
if not obj then return end
KapukaState.LocalizedObjects[obj] = {Raw = raw, Formatter = formatter}
obj:SetAttribute("KapukaLanguageKey", raw)
obj.Text = formatter and formatter() or KapukaState.translateDynamic(raw)
end
function KapukaState.setLocalizedText(obj, raw)
KapukaState.registerLocalizedObject(obj, raw)
end
function KapukaState.registerLocalizedPlaceholder(obj, raw)
if not obj then return end
obj:SetAttribute("KapukaPlaceholderKey", raw)
obj.PlaceholderText = KapukaState.t(raw)
end
function KapukaState.refreshLocalizedUI()
for obj, data in pairs(KapukaState.LocalizedObjects) do
if obj and obj.Parent then
obj.Text = data.Formatter and data.Formatter() or KapukaState.translateDynamic(data.Raw)
end
end
for _, obj in ipairs(KapukaState.ScreenGui:GetDescendants()) do
if obj:IsA("TextBox") then
local raw = obj:GetAttribute("KapukaPlaceholderKey")
if raw then obj.PlaceholderText = KapukaState.t(raw) end
end
end
for _, refresher in pairs(KapukaState.DynamicRefreshers) do pcall(refresher) end
end
function KapukaState.applyExactLocalization(root)
if not root then return end
local reverse = {}
for ru, en in pairs(KapukaState.Translations) do reverse[en] = ru end
for _, obj in ipairs(root:GetDescendants()) do
if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not obj:GetAttribute("KapukaNoLocalize") then
if not KapukaState.LocalizedObjects[obj] then
local current = obj.Text
local raw = KapukaState.Translations[current] and current or reverse[current]
if raw then
KapukaState.LocalizedObjects[obj] = {Raw = raw}
obj:SetAttribute("KapukaLanguageKey", raw)
end
end
if obj:IsA("TextBox") and not obj:GetAttribute("KapukaPlaceholderKey") and obj.PlaceholderText ~= "" then
local placeholder = obj.PlaceholderText
local rawPlaceholder = KapukaState.Translations[placeholder] and placeholder or reverse[placeholder]
if rawPlaceholder then obj:SetAttribute("KapukaPlaceholderKey", rawPlaceholder) end
end
end
end
KapukaState.refreshLocalizedUI()
end
function KapukaState.applyLanguage(root)
KapukaState.applyExactLocalization(root)
end
function KapukaState.setLanguage(lang)
KapukaState.LanguageSettings.Current = lang == "en" and "en" or "ru"
KapukaState.applyExactLocalization(KapukaState.ScreenGui)
for name in pairs(KapukaState.FunctionBinds) do pcall(KapukaState.refreshBindableButton, name) end
if KapukaState.BoneSelectorBtn and KapukaState.updateBoneSelectorText then pcall(KapukaState.updateBoneSelectorText) end
if KapukaState.ToggleUI["Позиция функций:"] then
local pos = KapukaState.statusPositionNames[KapukaState.StatusHUDSettings.Position] or "Верх-Лево"
KapukaState.ToggleUI["Позиция функций:"].Text = KapukaState.t(pos)
end
if KapukaState.MenuBindBtn then KapukaState.MenuBindBtn.Text = KapukaState.t(KapukaState.MenuSettings.ToggleBindName) end
if KapukaState.LanguageButton then KapukaState.LanguageButton.Text = KapukaState.LanguageSettings.Current == "en" and "English" or "Русский" end
if KapukaState.FontSelectorBtn then KapukaState.FontSelectorBtn.Text = KapukaState.getFontLabel() end
